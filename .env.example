# ──────────────────────────────────────────────────────────────
# Template de variáveis de ambiente. Copie para .env e preencha:
#   cp .env.example .env
# Convenção de nomes segue o template oficial do desafio.
# ──────────────────────────────────────────────────────────────

# ── Seleção de provider ───────────────────────────────────────
# Qual serviço gera os embeddings e responde: "openai" (padrão) ou "gemini".
# Só é preciso preencher a chave do provider escolhido.
# ATENÇÃO: trocar de provider exige rodar `python src/ingest.py` de novo
# (os vetores têm dimensões diferentes: 1536 na OpenAI, 3072 no Gemini).
LLM_PROVIDER=openai

# ── OpenAI (provider padrão) ──────────────────────────────────
OPENAI_API_KEY=sk-sua-chave-aqui
OPENAI_EMBEDDING_MODEL='text-embedding-3-small'

# LLM usado para responder. O enunciado menciona "gpt-5-nano";
# ajuste conforme a disponibilidade na sua conta (fallback: gpt-4o-mini).
OPENAI_MODEL=gpt-5-nano

# ── Gemini (alternativa; usado quando LLM_PROVIDER=gemini) ─────
GOOGLE_API_KEY=AIza-sua-chave-aqui
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001
GOOGLE_MODEL=gemini-2.5-flash

# ── Banco e ingestão ──────────────────────────────────────────
# Bate com o docker-compose.yml do template (postgres/postgres, db "rag", porta 5432).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag
PG_VECTOR_COLLECTION_NAME=document_chunks
PDF_PATH=document.pdf
